<?xml version="1.0" encoding="UTF-8"?>
<!--
    Журнал изменений Liquibase: две таблицы и изменения после их создания.
    По нему POST /v1/schemas/convert возвращает два запроса на генерацию.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="akvine">
        <createTable tableName="departments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="title" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="akvine">
        <createTable tableName="employees">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="department_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_employees_departments" references="departments(id)"/>
            </column>
            <column name="full_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="salary" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="hired_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="is_remote" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="legacy_code" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>

    <!-- Изменения после создания таблиц тоже учитываются -->
    <changeSet id="3" author="akvine">
        <addColumn tableName="employees">
            <column name="email" type="VARCHAR(255)"/>
        </addColumn>
        <addNotNullConstraint tableName="employees" columnName="email" columnDataType="VARCHAR(255)"/>
        <addUniqueConstraint tableName="employees" columnNames="email" constraintName="uk_employees_email"/>
        <dropColumn tableName="employees" columnName="legacy_code"/>
    </changeSet>
</databaseChangeLog>
